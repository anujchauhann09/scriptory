generator client {
  provider = "prisma-client-js"

  /// Engines to fetch, stated explicitly rather than left to detection.
  ///
  /// Prisma picks its query engine by sniffing the OpenSSL version at generate
  /// time. Inside the Alpine build image that sniff fails — the image ships the
  /// libssl.so.3 *library* but not the `openssl` CLI Prisma looks for — so it
  /// silently falls back to the openssl-1.1.x engine and the container then dies
  /// at first query with "Error loading shared library libssl.so.1.1".
  ///
  /// "native" covers whatever machine runs this locally; the musl target is the
  /// container. Naming both makes the build deterministic instead of dependent
  /// on what the base image happens to have installed.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model User {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // bumped to invalidate every outstanding JWT for this user (logout-everywhere,
  // password change, 2FA change). The token embeds the version it was signed with
  tokenVersion Int @default(0)

  // TOTP two-factor auth
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // active secret once enabled
  twoFactorPending String? // temp secret during setup, before first verification

  profile   Profile?
  articles  Article[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  @@index([createdAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  action     String
  actorUuid  String?
  actorEmail String?
  ip         String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/// Cross-instance brute-force counter for credential endpoints.
///
/// In-process rate limiting is per container, so under autoscaling an attacker's
/// guess budget multiplies by the instance count. Credential guessing is the one
/// case where that is unacceptable, so the counter lives in the database every
/// instance already shares — no Redis, no external rate-limit service.
/// Rows are short-lived and pruned by the maintenance task.
/// Mutual exclusion and replay protection for scheduled tasks.
///
/// Needed because an external scheduler is an at-least-once trigger, not
/// exactly-once. Cloud Scheduler retries on any non-2xx response and on a
/// deadline it did not hear back from — including the case where the work
/// actually completed but the response was lost. For an idempotent task that is
/// harmless; for the newsletter digest it means every subscriber receives a
/// second copy.
///
/// Two guarantees, both settled in a single atomic statement:
///   - `lockedUntil` stops two runs overlapping (the cron firing while an admin
///     presses "Send digest"). It is a lease, not a lock, so a runner that
///     crashes mid-task cannot block the job forever.
///   - `lastRunKey` stops the same logical run happening twice. A retry that
///     carries the key of a run that already finished is skipped.
///
/// Uses the Postgres instance the app already depends on — no Redis, no
/// external coordination service.
model TaskLease {
  task        String    @id
  /// Held while a run is in flight; null or past means the task is free.
  lockedUntil DateTime?
  /// Identifies the logical occurrence, e.g. "2026-W35" for a weekly digest.
  lastRunKey  String?
  lastRunAt   DateTime?
  updatedAt   DateTime  @updatedAt
}

model LoginThrottle {
  key         String   @id // "email:<address>" or "ip:<client key>"
  failures    Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model Profile {
  id        Int     @id @default(autoincrement())
  uuid      String  @unique @default(uuid())
  userId    Int     @unique
  name      String?
  bio       String?
  avatarUrl String?
  user      User    @relation(fields: [userId], references: [id])
}

model Article {
  id          Int            @id @default(autoincrement())
  uuid        String         @unique @default(uuid())
  title       String
  subtitle    String?
  slug        String         @unique
  excerpt     String?
  content     String
  contentSource Json?
  contentFormat String         @default("legacy-html")
  contentVersion Int           @default(0)
  coverImage  String?
  published   Boolean        @default(true)
  publishAt   DateTime? // when set in the future, a cron auto-publishes it

  /// Retired from discovery, still readable at its URL.
  ///
  /// Deliberately not the same thing as `published: false`. A draft is work
  /// that was never released; an archived article *was* released and stays
  /// released — its URL, comments, likes and view count all keep working, so
  /// every inbound link, bookmark and search result a reader already has still
  /// resolves. What it gives up is discovery: the archive listing, search, the
  /// RSS feed, the sitemap, related posts and the newsletter digest all skip
  /// it. Keeping the link alive is the entire difference between archiving and
  /// unpublishing, and the reason this is a separate column rather than a
  /// second meaning bolted onto `published`.
  ///
  /// A timestamp rather than a boolean: "when was this retired" is worth
  /// recording and costs nothing, and null is an unambiguous "not archived".
  archivedAt  DateTime?
  embedding   Json? // content-similarity vector for "related posts"
  readingTime Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  authorId    Int
  author      User           @relation(fields: [authorId], references: [id])
  tags        TagOnArticle[]
  comments    Comment[]
  views       View?
  likes       Like[]
  bookmarks   Bookmark[]

  // Optional membership in a multi-part series
  seriesId    Int?
  seriesOrder Int?
  series      Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  // Optional learning category. Nullable by design: an article may be published
  // with no category at all, and may be filed (or re-filed) later without any
  // change to the article itself. SetNull, never Cascade — retiring a category
  // must unfile its articles, never delete them.
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([createdAt])
  @@index([published])
  // Every listing, feed and recommendation now carries an `archivedAt IS NULL`
  // predicate, so it is worth an index of its own.
  @@index([archivedAt])
  @@index([authorId, createdAt])
  @@index([seriesId])
  @@index([categoryId])
  // Serves the common listing query: published articles in one category, newest
  // first.
  @@index([categoryId, published, createdAt])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

/// A curated learning category — the top-level shelf an article sits on.
///
/// Deliberately different from Tag and Series, which both auto-create whatever
/// name the editor types:
///   - Tag is an open vocabulary, many per article (free-form topics).
///   - Series is a *sequence* of parts within one multi-part piece.
///   - Category is a CLOSED vocabulary, at most one per article, and is the
///     stable structure the site's learning path is organised around.
///
/// Rows are seeded by migration rather than created on demand, so a typo in the
/// editor can never mint "Backened Engineering" as a permanent category.
model Category {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  /// URL-safe identifier; what the API and query params speak in.
  slug        String    @unique
  name        String    @unique
  description String?
  /// Position in the intended learning progression, ascending.
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  articles    Article[]

  @@index([sortOrder])
}

model Series {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  title       String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model Tag {
  id       Int            @id @default(autoincrement())
  uuid     String         @unique @default(uuid())
  name     String         @unique
  articles TagOnArticle[]
}

model TagOnArticle {
  articleId Int
  tagId     Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  content   String
  createdAt DateTime @default(now())
  userId    Int
  articleId Int
  user      User     @relation(fields: [userId], references: [id])
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
  @@index([createdAt])
  @@index([articleId, createdAt])
}

model View {
  id        Int          @id @default(autoincrement())
  uuid      String       @unique @default(uuid())
  articleId Int          @unique
  count     Int          @default(0)
  article   Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  records   ViewRecord[]
}

model ViewRecord {
  id          Int      @id @default(autoincrement())
  articleId   Int
  viewId      Int
  userId      Int? // null = anonymous
  fingerprint String // IP+UA hash for anonymous, uuid for logged-in
  createdAt   DateTime @default(now())

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)

  // One unique view per viewer per article
  @@unique([articleId, fingerprint])
  @@index([articleId])
  @@index([userId])
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  name      String
  email     String
  message   String
  ipHash    String?
  userAgent String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([handled])
}

model Subscriber {
  id               Int              @id @default(autoincrement())
  uuid             String           @unique @default(uuid())
  email            String           @unique
  status           SubscriberStatus @default(SUBSCRIBED)
  unsubscribeToken String           @unique @default(uuid())
  createdAt        DateTime         @default(now())
  unsubscribedAt   DateTime?

  @@index([status])
  @@index([createdAt])
}
