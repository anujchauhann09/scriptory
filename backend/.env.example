# ===========================================================================
# Scriptory API configuration
#
# Every value here is read through src/config/env.js. Nothing in the app reads
# a vendor-specific variable directly, so the same file shape works on any host.
#
# Any secret FOO may instead be supplied as FOO_FILE pointing at a mounted file
# (GCP Secret Manager volume, Kubernetes secret, Docker secret). The file form
# is preferred in production: it stays out of `docker inspect`, out of child
# process environments, and can be rotated without a redeploy.
# ===========================================================================

# --- core -----------------------------------------------------------------
NODE_ENV="development"
# The platform injects this; do not hard-code it in a container deployment.
PORT=5000

# Must be at least 32 characters in production. Generate with:
#   openssl rand -base64 48
JWT_SECRET="replace-me-with-openssl-rand-base64-48"
JWT_EXPIRES_IN="7d"
# Bind tokens to this service so a token minted elsewhere is not accepted here.
JWT_ISSUER="scriptory"
JWT_AUDIENCE="scriptory-api"

# --- database -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/scriptory"

# Unix-socket transport, for platforms that mount one. Leave UNSET for TCP,
# which is what Cloud Run + private-IP Cloud SQL uses: the socket integration
# resolves the instance over its public endpoint, and a private-IP-only instance
# does not have one. With it unset, DATABASE_URL points straight at the private
# IP and sslmode=require is added automatically in production.
# DB_SOCKET_PATH="/cloudsql/my-project:asia-south1:scriptory-db"

# Connections held per instance.
#
# Budget: DB_POOL_MAX x MAX_INSTANCES is the steady state, and roughly DOUBLE
# that during a rolling deploy while the old and new revisions both serve. That
# peak is what must fit under the tier's max_connections, minus the connections
# the managed service reserves for itself.
#
# On a shared-core Cloud SQL instance (db-f1-micro, 25 connections) the safe
# shape is DB_POOL_MAX=3 with MAX_INSTANCES=2: 6 steady, 12 peak, ~10 spare.
DB_POOL_MAX=3
# The tier's ceiling and its reserved slots, so the app can check its own budget
# at startup and log loudly if the numbers stop adding up.
DB_MAX_CONNECTIONS=25
DB_RESERVED_CONNECTIONS=3
# Seconds a query waits for a free pooled connection before failing fast.
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10

# --- platform -------------------------------------------------------------
# Auto-detected; override only to force a specific adapter.
# PLATFORM="gcp-cloud-run"

# Reverse proxies in front of this process. This decides what req.ip resolves
# to, and req.ip is the key for every rate limiter — so it must be exact.
#   0 = no proxy (local)
#   1 = one proxy (Cloud Run, most managed runtimes, a single ingress)
#   2 = two (e.g. an external load balancer in front of Cloud Run)
# TRUST_PROXY_HOPS=1

# Upper bound on concurrent instances. In-process rate limits are per instance,
# so the effective global ceiling is roughly limit x MAX_INSTANCES. Keep this in
# sync with the platform's max-instances setting.
MAX_INSTANCES=2

# --- URLs and CORS --------------------------------------------------------
# Required in production. Drives CORS, the CSRF origin allowlist, and the
# canonical links in feeds and emails.
FRONTEND_URL="http://localhost:3000"
# Extra allowed browser origins, comma-separated (preview deploys, apex + www).
# CORS_ALLOWED_ORIGINS="https://www.example.com,https://preview.example.com"

# Public base URL of THIS API. Required in production; builds unsubscribe links.
API_URL="http://localhost:5000"

# First-deployment escape hatch, for platforms that mint the service URL only
# after the service exists. Honoured ONLY when API_URL is absent. While set, the
# service boots without a public URL and newsletter emails are withheld, because
# their unsubscribe links cannot be built. Set API_URL to the generated address
# and remove this flag on the second deploy.
# API_URL_PENDING="true"

# --- session cookie -------------------------------------------------------
# "lax" when the frontend and API share a site (including localhost).
# "none" when they are on different sites — required for a separately-hosted
# SPA, and it removes the browser's implicit CSRF protection, which is why the
# Origin check in csrf.middleware.js exists. "none" forces Secure (HTTPS).
COOKIE_SAMESITE="lax"
# COOKIE_DOMAIN=".yourdomain.com"   # optional — share the cookie across subdomains

# --- brute-force protection ----------------------------------------------
# Enforced in the database, so the ceiling holds across every instance.
LOGIN_THROTTLE_WINDOW_SECONDS=900
# Per account. Low, because an account owner rarely fails eight times.
LOGIN_THROTTLE_MAX_ACCOUNT=8
# Per client IP. Higher, so a shared office NAT is not locked out as a group.
LOGIN_THROTTLE_MAX_IP=30

# --- background work ------------------------------------------------------
# "cron"     — in-process timers. Only correct for a single always-on instance.
# "external" — expose /internal/tasks/* for a platform scheduler to call.
#              The default on serverless platforms, where in-process cron either
#              never fires (scaled to zero) or fires once per instance.
# "off"      — no background work at all.
# SCHEDULER_MODE="external"

# Shared secret an external scheduler presents to /internal/tasks/*.
# Required when SCHEDULER_MODE=external. Unset leaves those endpoints closed.
# TASK_RUNNER_TOKEN="openssl rand -base64 32"

# In-process digest cron. Ignored when MAX_INSTANCES > 1, because every instance
# would send its own copy to every subscriber.
NEWSLETTER_DIGEST_ENABLED="false"
NEWSLETTER_DIGEST_CRON="0 9 * * 1"    # Mondays 09:00

# --- timeouts -------------------------------------------------------------
# Keep below the platform's own request timeout so the app produces the error.
REQUEST_TIMEOUT_MS=30000
# Grace period for in-flight requests after SIGTERM. Keep below the platform's
# termination grace period (Cloud Run allows 10s by default).
SHUTDOWN_TIMEOUT_MS=10000
# Must exceed the fronting load balancer's idle timeout, or the proxy will
# reuse a connection the server just closed and report a 502.
KEEP_ALIVE_TIMEOUT_MS=65000

# --- logging --------------------------------------------------------------
# Production emits one JSON object per line on stdout, which every managed log
# collector parses natively. Passwords, tokens and query-string secrets are
# redacted before anything is written.
# LOG_LEVEL="info"
SLOW_QUERY_MS=500

# --- admin seed -----------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
# Set a strong, unique value before seeding, and enable 2FA after first login.
# Never commit a real password. Generate one with: openssl rand -base64 24
ADMIN_PASSWORD=""

# --- Media storage ---------------------------------------------------------
# GCS is used through Application Default Credentials. On Cloud Run, grant the
# runtime service account objectUser on this bucket; do not store key files.
MEDIA_STORAGE_PROVIDER="gcs"
GCS_MEDIA_BUCKET="scriptory-media-506807"

# --- Gemini embeddings (optional) -----------------------------------------
# Server-side only. Never expose this to the frontend bundle; without a key,
# related posts fall back to shared tags.
GEMINI_API_KEY=""
EMBEDDING_MODEL="gemini-embedding-2"

# --- SMTP (optional) ------------------------------------------------------
# If unset, emails are logged and skipped; submissions still persist.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"          # true for port 465
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
MAIL_FROM="Scriptory <no-reply@scriptory.com>"
# Where contact-form messages are delivered (defaults to ADMIN_EMAIL)
CONTACT_RECIPIENT="you@example.com"
