# Base URL of the Scriptory API, including the /api suffix.
#
# Anything prefixed VITE_ is compiled into the bundle as a literal and served to
# every visitor — that prefix is Vite's boundary marker, not a naming
# convention. Never put a credential behind it. Backend secrets (Gemini,
# media storage, SMTP) belong to the API and nowhere else.
#
# A production build refuses to run if this is missing, points at localhost, or
# is not https:// — a bundle is immutable once built, so a stale value here
# ships a site that calls the wrong host from every visitor's browser.
VITE_API_URL="http://localhost:5000/api"
